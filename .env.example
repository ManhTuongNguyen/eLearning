# English Learning Chat — example environment file.
# Copy to .env and fill in real values. Never commit the real .env.
#
# Variables marked [REQUIRED IN PRODUCTION] must be set when DJANGO_DEBUG=False;
# the backend refuses to start with a clear error otherwise.

# --- Django ---
# [REQUIRED IN PRODUCTION]
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# [REQUIRED IN PRODUCTION] — must be non-empty
# Comma-separated. 10.0.2.2 is the Android emulator host alias.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# --- PostgreSQL ---
# Under Docker Compose, POSTGRES_HOST is overridden to the `postgres` service.
# [REQUIRED IN PRODUCTION] POSTGRES_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=elearning
POSTGRES_USER=elearning
POSTGRES_PASSWORD=change-me
# Dedicated database created/destroyed by pytest runs; never the dev database.
POSTGRES_TEST_DB=test_elearning
# Optional: set to sqlite3 for quick local development without Docker.
DB_ENGINE=postgresql

# --- Redis ---
# Under Docker Compose, REDIS_URL / CELERY_* URLs are overridden to the
# `redis` service hostname.
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Optional: execute Celery tasks synchronously in-process (local debugging).
CELERY_TASK_ALWAYS_EAGER=False

# --- JWT ---
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# --- Authentication rate limiting ---
# Per-IP rate limit for anonymous identity-establishing endpoints
# (registration, login, refresh, logout). Format follows DRF throttle rates
# ("<count>/<period>", e.g. "10/min", "100/hour"). Keep tight to make
# credential-stuffing and brute force attacks impractical.
AUTH_THROTTLE_RATE=10/min

# --- LLM provider ---
# Selects the server-side provider integration (llm/registry.py). Supported:
# openrouter | gemini | openai | ninerouter | openai-compatible.
# The provider decides which <PREFIX>_API_KEY / <PREFIX>_BASE_URL pair below
# is used. Switching provider is a configuration change, never a code change.
LLM_PROVIDER=openrouter

# --- OpenRouter (LLM_PROVIDER=openrouter) ---
# Server-side key. Never expose this to the mobile application.
# [REQUIRED IN PRODUCTION] the configured provider's API key
OPENROUTER_API_KEY=
# OpenRouter API root; override only for proxies/testing.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Google Gemini (LLM_PROVIDER=gemini) ---
# [REQUIRED IN PRODUCTION] the configured provider's API key
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- OpenAI (LLM_PROVIDER=openai) ---
# [REQUIRED IN PRODUCTION] the configured provider's API key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- 9Router (LLM_PROVIDER=ninerouter) ---
# 9Router is an OpenAI-compatible gateway; the default matches a local
# router install — override for a remotely deployed instance.
# [REQUIRED IN PRODUCTION] the configured provider's API key
NINEROUTER_API_KEY=
NINEROUTER_BASE_URL=http://localhost:20128/v1

# --- Generic OpenAI-compatible provider (LLM_PROVIDER=openai-compatible) ---
# Any vendor exposing the OpenAI chat-completions contract. The base URL
# is mandatory for this provider (no vendor default exists).
# [REQUIRED IN PRODUCTION] the configured provider's API key
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# --- Model chain (shared by every provider) ---
# Server-mode model chain, tried in order: primary first, then each fallback
# (comma-separated). Only used when the primary fails with a retryable error
# (timeouts, transport problems, provider availability). Model ids follow the
# configured provider's catalog (for OpenRouter: "vendor/model", e.g.
# openai/gpt-4o-mini — see GET https://openrouter.ai/api/v1/models). No model
# names are hard-coded in application code; change them here without touching
# business logic.
LLM_PRIMARY_MODEL=openai/gpt-4o-mini
LLM_FALLBACK_MODELS=openai/gpt-4o,anthropic/claude-3.5-haiku
# Per-request HTTP timeout for provider calls (seconds, > 0).
# Total timeout for non-streaming requests; for streaming, use the
# connect/read timeouts below for more granular control.
LLM_REQUEST_TIMEOUT_SECONDS=60
# Connection establishment timeout for provider calls (seconds, > 0).
LLM_CONNECT_TIMEOUT_SECONDS=10
# Read timeout for provider calls (seconds, > 0).
# For streaming, this is the maximum time to wait between chunks.
LLM_READ_TIMEOUT_SECONDS=60

# --- Conversation context ---
# How many of the most recent conversation messages are sent to the model
# with each chat turn (older turns leave the window and belong to the rolling
# summary). Must be a positive integer.
CONTEXT_RECENT_MESSAGE_WINDOW=20
# How many unsummarized messages may pile up beyond the recent window before
# the rolling summary is refreshed. Summarization is batched: short
# conversations never trigger it, and it never runs after every message.
# Must be a positive integer.
CONTEXT_SUMMARY_TRIGGER_THRESHOLD=40
