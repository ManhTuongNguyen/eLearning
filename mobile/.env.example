# eLearning Mobile — example environment file.
# Copy to .env and fill in real values. Never commit the real .env.
#
# Values are inlined into the JS bundle at build time by the
# react-native-dotenv babel plugin (mobile/babel.config.js). Only put public
# configuration here — never API keys or other secrets.

# --- Backend server ---
# Base URL of the Django backend (a trailing slash is removed automatically).
#
# Which file supplies which build:
#   .env             local defaults, loaded in every mode (not committed)
#   .env.development debug bundles (Metro dev server)
#   .env.test        jest runs (jest sets NODE_ENV=test)
#   .env.production  release bundles (`cd android && ./gradlew assembleRelease`)
#
# The Android emulator reaches the host machine's loopback interface at
# 10.0.2.2, which is where the Docker Compose backend publishes port 8000.
# A physical device on the same network needs the host's LAN IP instead.
API_BASE_URL=http://10.0.2.2:8000
