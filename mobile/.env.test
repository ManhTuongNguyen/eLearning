# Jest environment configuration (committed — contains only mock values).
# Jest runs with NODE_ENV=test, so react-native-dotenv loads this file on top
# of the base .env. Every URL here is a mock that is never contacted: the test
# suite mocks fetch/XHR and compares request URLs against the same config
# values, keeping tests deterministic regardless of a developer's local .env.
API_BASE_URL=http://test.local:8000
